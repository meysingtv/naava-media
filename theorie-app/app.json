{
  "expo": {
    "name": "Fahrschule Pro",
    "slug": "spur-theorie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spur",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030507",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "de.spur.theorie",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "de.spur.theorie",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030507",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/benachrichtigung.png",
          "color": "#FC5B0E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fahrschule Pro greift nur auf deine Fotos und Videos zu, wenn du ein Profilbild, einen Clip zum Hochladen oder ein Schildfoto für die Schilder-Jagd auswählst.",
          "cameraPermission": "Fahrschule Pro nutzt die Kamera für die Schilder-Jagd: Du scannst echte Verkehrsschilder für dein Album. Die Fotos werden nur auf deinem Gerät ausgewertet und nicht gespeichert.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fahrschule Pro nutzt die Kamera für die Schilder-Jagd: Du scannst echte Verkehrsschilder für dein Album. Die Fotos werden nur auf deinem Gerät ausgewertet und nicht gespeichert.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/android-sicherheit",
      "expo-secure-store",
      "react-native-compressor",
      "@bacons/apple-targets",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
