{
  "expo": {
    "name": "Fahrschul Pro",
    "slug": "spur-theorie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spur",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030507",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "de.spur.theorie",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "de.spur.theorie",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-leer.png",
          "imageWidth": 140
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/benachrichtigung.png",
          "color": "#FC5B0E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fahrschul Pro greift nur auf deine Fotos und Videos zu, wenn du ein Profilbild, einen Clip zum Hochladen, ein Schildfoto für die Schilder-Jagd oder ein Bild für deinen Live-Stream auswählst.",
          "cameraPermission": "Fahrschul Pro nutzt die Kamera für die Schilder-Jagd (du scannst echte Verkehrsschilder, die Fotos werden nur auf deinem Gerät ausgewertet und nicht gespeichert) und für Live-Streams in Clips.",
          "microphonePermission": "Fahrschul Pro nutzt das Mikrofon nur, wenn du in Clips einen Live-Stream startest."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Fahrschul Pro nutzt die Kamera für die Schilder-Jagd (du scannst echte Verkehrsschilder, die Fotos werden nur auf deinem Gerät ausgewertet und nicht gespeichert) und für Live-Streams in Clips.",
          "microphonePermission": "Fahrschul Pro nutzt das Mikrofon nur, wenn du in Clips einen Live-Stream startest.",
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-apple-authentication",
      "./plugins/android-sicherheit",
      "expo-secure-store",
      "react-native-compressor",
      "@bacons/apple-targets",
      "@react-native-community/datetimepicker",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "media"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Fahrschul Pro nutzt die Kamera für die Schilder-Jagd (du scannst echte Verkehrsschilder, die Fotos werden nur auf deinem Gerät ausgewertet und nicht gespeichert) und für Live-Streams in Clips.",
          "microphonePermission": "Fahrschul Pro nutzt das Mikrofon nur, wenn du in Clips einen Live-Stream startest."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Klassik",
            "ios": "./assets/app-icons/ios/klassik.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/klassik.png",
              "backgroundColor": "#EEF2F8"
            }
          },
          {
            "name": "Nacht",
            "ios": "./assets/app-icons/ios/nacht.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/nacht.png",
              "backgroundColor": "#0B1018"
            }
          },
          {
            "name": "Orange",
            "ios": "./assets/app-icons/ios/orange.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/orange.png",
              "backgroundColor": "#F2540A"
            }
          },
          {
            "name": "Ozean",
            "ios": "./assets/app-icons/ios/ozean.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/ozean.png",
              "backgroundColor": "#2453C9"
            }
          },
          {
            "name": "Racing",
            "ios": "./assets/app-icons/ios/racing.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/racing.png",
              "backgroundColor": "#C80F1C"
            }
          },
          {
            "name": "Gold",
            "ios": "./assets/app-icons/ios/gold.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/gold.png",
              "backgroundColor": "#111113"
            }
          },
          {
            "name": "Neon",
            "ios": "./assets/app-icons/ios/neon.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/neon.png",
              "backgroundColor": "#14072B"
            }
          },
          {
            "name": "Carbon",
            "ios": "./assets/app-icons/ios/carbon.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/carbon.png",
              "backgroundColor": "#16181C"
            }
          },
          {
            "name": "Sunset",
            "ios": "./assets/app-icons/ios/sunset.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/sunset.png",
              "backgroundColor": "#FF8A6A"
            }
          },
          {
            "name": "Mint",
            "ios": "./assets/app-icons/ios/mint.png",
            "android": {
              "foregroundImage": "./assets/app-icons/android/mint.png",
              "backgroundColor": "#12A985"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
