# Supabase-Projekt der Lern-App (am besten ein eigenes Projekt, nicht das der
# Fahrschul-Software). Zu finden unter Project Settings -> API.
# Ohne diese Werte läuft die App im Gastmodus (Lernstand nur auf dem Gerät).
EXPO_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Optional: Hilfe & Rechtliches in den Einstellungen
# EXPO_PUBLIC_SUPPORT_EMAIL=hilfe@deine-domain.de
# EXPO_PUBLIC_DATENSCHUTZ_URL=https://deine-domain.de/datenschutz
# EXPO_PUBLIC_IMPRESSUM_URL=https://deine-domain.de/impressum
# EXPO_PUBLIC_AGB_URL=https://deine-domain.de/agb
