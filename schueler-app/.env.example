# Supabase – exakt dieselben Werte wie in der Web-App (.env.local),
# nur mit dem Prefix EXPO_PUBLIC_ statt NEXT_PUBLIC_.
# Zu finden im Supabase-Dashboard unter Project Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Adresse der Web-App (für „Jetzt bezahlen“ mit Stripe) – ohne Schrägstrich am Ende.
# Produktion: https://deine-domain.de · Test im WLAN: http://192.168.178.78:3000
EXPO_PUBLIC_API_URL=https://deine-domain.de
