# Wohin sollen Demo-Anfragen geschickt werden?
DEMO_RECIPIENT_EMAIL=hallo@deine-domain.de

# Variante A – E-Mail-Versand über Resend (empfohlen, keine Extra-Abhängigkeit)
# Key hier eintragen: https://resend.com  (kostenloses Kontingent vorhanden)
RESEND_API_KEY=
# Absender-Adresse (muss bei Resend verifiziert sein)
DEMO_FROM_EMAIL=FahrschulApp <noreply@deine-domain.de>

# Variante B – klassisches SMTP (optional; siehe README, Adapter in lib/mail.ts)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Öffentliche Basis-URL (für SEO / Sitemap / Canonical)
NEXT_PUBLIC_SITE_URL=https://www.deine-domain.de
