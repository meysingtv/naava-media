# Supabase – im Supabase Dashboard unter "Project Settings" → "API" zu finden
# Diese Werte sind öffentlich (anon key) und dürfen im Browser verwendet werden.
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# Basis-URL der App (für E-Mail-Bestätigungs- und Einladungslinks).
# Diese URL landet in den Mails – sie muss von dem Gerät erreichbar sein,
# das die Mail öffnet (z. B. Handy im selben WLAN -> die LAN-IP nehmen):
#   Lokal am selben PC:        http://localhost:3000
#   Test mit Handy/Tablet:     http://192.168.178.78:3000
#   Produktion (Vercel):       https://deine-domain.de
# Wichtig: Dieselbe URL in Supabase unter Auth -> URL Configuration
# als "Redirect URL" (z. B. http://192.168.178.78:3000/**) eintragen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Service-Role-Key (NUR serverseitig, NIE im Browser!).
# Aktiviert die Fahrlehrer-Einladung per E-Mail. Zu finden unter
# Project Settings -> API -> "Legacy" oder "service_role". Optional.
# SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Anthropic API-Key für die KI-Lernstatus-Funktion (NUR serverseitig, NIE im
# Browser!). Zu finden unter https://console.anthropic.com -> API Keys.
# WICHTIG: niemals ins Git committen – gehört nur in .env.local / Vercel-Env.
# ANTHROPIC_API_KEY=sk-ant-...

# Schüler-Portal-Domains (kommagetrennt). Über diese Hostnamen wird das
# Schüler-Portal ausgeliefert; alles andere ist die Büro-/Admin-Ansicht.
# Beispiel: mein.deine-fahrschule.de,portal.deine-fahrschule.de
# Zusätzlich greifen automatisch Sub-Domains mein./schueler./portal.*.
# Lokal zum Testen brauchst du das nicht – ruf einfach /portal auf.
# PORTAL_HOSTS=mein.deine-fahrschule.de

# --- Marketing-Website (Demo-Formular unter app/api/demo) ---
# Wohin sollen Demo-Anfragen geschickt werden?
DEMO_RECIPIENT_EMAIL=hallo@deine-domain.de

# Variante A – E-Mail-Versand über Resend (empfohlen, keine Extra-Abhängigkeit)
# Key hier eintragen: https://resend.com  (kostenloses Kontingent vorhanden)
RESEND_API_KEY=
# Absender-Adresse (muss bei Resend verifiziert sein)
DEMO_FROM_EMAIL=FahrschulApp <noreply@deine-domain.de>

# Variante B – klassisches SMTP (optional; siehe README, Adapter in lib/mail.ts)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Öffentliche Basis-URL (für SEO / Sitemap / Canonical)
